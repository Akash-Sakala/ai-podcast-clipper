# Copy to ".env" in this folder (git-ignored):  Copy-Item .env.example .env -Force
# Read by `modal deploy main.py` (and by rank_moments.py). Re-deploy after changes.
# Values set in the shell (e.g. $env:CLIPPER_GPU = "L40S") override this file.

# GPU for the cloud pipeline: Parakeet v2 transcription, Gemini call and clip
# rendering. A10 ($1.10/h on Modal) is enough; L4 is cheaper and slower, L40S faster.
CLIPPER_GPU=A10

# --- Moment selection --------------------------------------------------------
# A job never ends with fewer clips than this: if Gemini returns fewer usable
# moments, the rest are picked from the transcript (marked "fallback").
MIN_CLIPS=3
# Clip length limits in seconds.
CLIP_MIN_SECONDS=30
CLIP_MAX_SECONDS=60
# A clip may run this much longer than CLIP_MAX_SECONDS, only to finish the sentence
# it is in (clips always start and end on whole sentences).
CLIP_GRACE_SECONDS=5
# Gemini models tried in order (first = primary unless GEMINI_MODEL is set in the
# Modal secret). Check the IDs your key can use: python rank_moments.py --list-models
GEMINI_MODELS=gemini-3.8-flash,gemini-3.6-flash,gemini-3.5-flash-lite
# A busy model (429/503/504) gets this many quick retries before the next model.
GEMINI_BUSY_RETRIES=1
GEMINI_BUSY_WAIT_SECONDS=3
# Gemini 3 thinking level for ranking: minimal | low | medium | high (empty = default).
GEMINI_THINKING_LEVEL=low
# Leave empty to use the model's default temperature (recommended for Gemini 3).
GEMINI_TEMPERATURE=
# Per-request timeout, and the total time ranking may take before the transcript
# fallback is used (the GPU waits during ranking, so keep this bounded).
GEMINI_TIMEOUT_SECONDS=120
RANKING_TIME_LIMIT_SECONDS=240

# --- Only for rank_moments.py on this laptop ---------------------------------
# GEMINI_API_KEY=your-key
