# Copy to ".env" in this folder (git-ignored):  Copy-Item .env.example .env
# Values set in the shell (e.g. $env:CLIPPER_GPU = "L40S") override this file.
#
# Which setting needs what (details: docs/advanced.md, "Settings"):
#   [deploy]  read by `modal deploy main.py`: run it again after changing the value
#   [runner]  read by runner.py when a run starts: no redeploy
# Lines starting with "#" are optional; the value shown is the default.

# --- Everyday ----------------------------------------------------------------
# [deploy] GPU for transcription and for each clip's render container. A comma-separated
# list is a fallback order (e.g. L40S,A10). Needs an NVENC video encoder (L4, A10, L40S);
# A100/H100/H200/B200 have none. Compare them: modal run benchmark_gpu.py --job-dir ...
CLIPPER_GPU=A10
# [runner] on: download YouTube over IPv4 (avoids timeouts on a broken IPv6 route).
YOUTUBE_IPV4=on
# [runner] Rendered clips downloaded from Modal at the same time (1-16, default 8). 2 was
# the old value: set it to compare speeds (runner.log shows the Mbps). No redeploy.
CLIP_DOWNLOADS_AT_ONCE=8
# [runner] YouTube's Most replayed graph and SponsorBlock, read on this laptop before each
# YouTube run. The app's Settings page overrides these three.
MOST_REPLAYED=on
SPONSORBLOCK=on
# Share of the final score from the audience, 0-1 (0.4 = 60% Gemini, 40% viewers).
REPLAY_WEIGHT=0.4

# --- YouTube cookies [runner] ------------------------------------------------
# When YouTube asks to "confirm you're not a bot". The file wins over the browser.
# A cookies.txt exported from Chrome (the way to use Chrome: other programs can't read its
# cookies on Windows). Keep the file outside OneDrive and private.
# YTDLP_COOKIES_FILE=C:\Users\you\podcast-clipper-cookies\youtube.txt
# A browser yt-dlp can read: firefox.
# YTDLP_COOKIES_FROM_BROWSER=firefox

# --- Rendering and clip selection (all optional) -----------------------------
# [deploy] Most clip render containers at once (Modal Starter allows 10 GPUs).
# RENDER_MAX_CONTAINERS=8
# [deploy] CPU cores reserved per render container.
# RENDER_CPU=4
# [deploy] Shortest time the crop stays on one speaker before it may switch, in seconds. 0 = off.
# SPEAKER_MIN_HOLD_SECONDS=0.5
# [deploy] Flash frames: up to this many frames of another shot between two cuts show the
# frame before instead. 0 = off.
# FLASH_FRAMES_MAX=3
# [deploy] A job never ends with fewer clips; missing ones come from the transcript.
# MIN_CLIPS=3
# [deploy] Clip length limits in seconds, and how far a clip may run over the maximum to
# finish its sentence.
# CLIP_MIN_SECONDS=30
# CLIP_MAX_SECONDS=60
# CLIP_GRACE_SECONDS=5

# --- Gemini tuning (all optional, [deploy]) ----------------------------------
# Models tried in order. List the IDs your key can use: python rank_moments.py --list-models
# GEMINI_MODELS=gemini-3.8-flash,gemini-3.6-flash,gemini-3.5-flash-lite
# Also GEMINI_BUSY_RETRIES, GEMINI_BUSY_WAIT_SECONDS, GEMINI_THINKING_LEVEL,
# GEMINI_TEMPERATURE, GEMINI_TIMEOUT_SECONDS, RANKING_TIME_LIMIT_SECONDS: see docs/advanced.md.

# --- Test deployment next to the real app (optional, [deploy] and [runner]) ----
# A second app with its own volume and progress Dict ("<name>-jobs", "<name>-progress").
# The secret is shared unless CLIPPER_SECRET is set. Remove both lines to go back.
# CLIPPER_APP=ai-podcast-clipper-test
# CLIPPER_SECRET=ai-podcast-clipper-secret

# --- Only for rank_moments.py on this laptop ---------------------------------
# GEMINI_API_KEY=your-key
