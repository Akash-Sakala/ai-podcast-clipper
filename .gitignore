# =============================================================================
# SECRETS & CREDENTIALS - never commit these
# =============================================================================
.env
.env.*
!.env.example
*.pem
*.key
cookies.txt
*cookies*.txt
.modal.toml
client_secret*.json
credentials*.json
service-account*.json
token.json
secrets/

# =============================================================================
# LOCAL JOB DATA - videos, clips, transcripts, runner logs (can be many GB)
# =============================================================================
/data/
*.mp4
*.mov
*.mkv
*.webm
*.avi
*.m4a
*.mp3
*.wav
*.flac
*.aac
# ...but allow small demo media for the README
!docs/assets/*.mp4

# =============================================================================
# MODEL WEIGHTS & ML ARTIFACTS - download them, don't commit them
# (asd/weight/*.model are small, MIT-licensed upstream files and stay tracked)
# =============================================================================
*.pth
*.pt
*.ckpt
*.safetensors
*.onnx
*.h5
*.npy
*.npz
*.pkl
*.pckl
mlruns/
wandb/
/checkpoints/

# LR-ASD scratch output (generated per clip)
**/pyavi/
**/pywork/
**/pyframes/
**/pycrop/

