# Secrets and credentials
.env
.env.*
!.env.example
*.pem
*.key
*cookies*.txt

# Local job data: videos, clips, transcripts, logs (can be many GB)
/data/
*.mp4
*.mov
*.mkv
*.webm
*.avi
*.m4a
*.mp3
*.wav
*.flac
*.aac

# Model weights: download them (python download_weights.py), don't commit them.
# asd/weight/*.model are small MIT-licensed upstream files and stay tracked.
*.pth
*.safetensors
*.onnx

# LR-ASD scratch output (generated per clip by Columbia_test.py / benchmark_gpu.py --parity)
**/pyavi/
**/pywork/
**/pyframes/
**/pycrop/
*.pckl

# Python (backend / Modal / runner)
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# Node / Next.js (frontend; more in ai-podcast-clipper-frontend/.gitignore)
node_modules/
.next/

# Logs and temp files
*.log
*.tmp
*.swp
*.swo

# OS and editor noise
.DS_Store
Thumbs.db
desktop.ini
~$*
.idea/
.vscode/

# Claude Code: local settings and the private handoff notes (CLAUDE.md, with an identical AGENTS.md)
.claude/settings.local.json
CLAUDE.md
AGENTS.md

# Demo video: source assets and /brag output (local only)
demo-assets/
brag-output*/
