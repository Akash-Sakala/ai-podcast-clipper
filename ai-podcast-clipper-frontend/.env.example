# Copy this file to ".env" if you need to change the defaults.
# Both settings are optional - with the standard repo layout no .env is needed.
# When adding variables, update the schema in "src/env.js" too.

# Folder for job data (uploaded videos, clips, logs). Relative paths are resolved
# from this frontend folder. Default: ../data
# Tip: the repo is inside OneDrive - point this outside it so large videos aren't synced:
# DATA_DIR="C:\podcast-clipper-data"
DATA_DIR=""

# Python interpreter that runs ../ai-podcast-clipper-backend/runner.py.
# Default: ../ai-podcast-clipper-backend/.venv/Scripts/python.exe (Windows)
RUNNER_PYTHON=""

# Optional: if YouTube downloads fail with "Sign in to confirm you're not a bot",
# let yt-dlp use your browser's YouTube login: firefox (recommended), edge or chrome.
YTDLP_COOKIES_FROM_BROWSER=""
