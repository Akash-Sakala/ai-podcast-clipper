# Copy this file to ".env" only if you need to change a default. With the standard repo
# layout no .env is needed. Both settings are optional and read in "src/env.ts".

# Folder for job data (uploaded videos, clips, logs, stats, settings). Relative paths are
# resolved from this frontend folder. Default: %LOCALAPPDATA%\ai-podcast-clipper\data (outside
# OneDrive), or ../data while that still holds an older version's jobs (move them once with
# scripts\move-data.ps1).
# DATA_DIR=C:\podcast-clipper-data

# Python interpreter that runs ../ai-podcast-clipper-backend/runner.py.
# Default: ../ai-podcast-clipper-backend/.venv/Scripts/python.exe on Windows,
# ../ai-podcast-clipper-backend/.venv/bin/python elsewhere.
# RUNNER_PYTHON=

# YouTube cookies (YTDLP_COOKIES_FILE, YTDLP_COOKIES_FROM_BROWSER) belong in the BACKEND
# .env: see ai-podcast-clipper-backend/.env.example. An old frontend .env that still sets
# them keeps working (the app passes its environment on to the runner), and wins over the
# backend file even when its lines are empty: delete those lines when you move the settings.
